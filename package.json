{
  "name": "levelup-literacy",
  "version": "0.7.3",
  "private": true,
  "description": "Self-paced literacy mini courses for teens, mapped to the Victorian Curriculum F-10 v2.0 English.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-content.js",
    "pdf": "node --disable-warning=ExperimentalWarning scripts/workbook-pdf.js",
    "map-doc": "node --disable-warning=ExperimentalWarning scripts/course-map-doc.js",
    "import-vcaa": "node scripts/import-vcaa.js",
    "voices": "node --disable-warning=ExperimentalWarning scripts/make-voices.js",
    "live": "bash scripts/live.sh"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.50.0",
    "express": "^5.3.0",
    "lucide-static": "^1.65.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "qrcode": "^1.5.4"
  }
}
