{
  // GitHub Codespaces setup: open a codespace and Level Up starts by itself.
  "name": "Level Up Literacy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Level Up", "onAutoForward": "openBrowser" }
  },
  // Every time you open (or reopen) the codespace: fetch the latest version,
  // install anything new, add demo accounts the first time, and start the app.
  "postAttachCommand": "bash scripts/live.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": [] }
  }
}
